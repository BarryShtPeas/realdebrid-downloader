# Real-Debrid
REALDEBRID_API_TOKEN=
REALDEBRID_API_BASE_URL=https://api.real-debrid.com/rest/1.0

# Web app
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=info
APP_DOWNLOAD_DIR=/downloads
APP_CONFIG_DIR=/config
APP_SUBMITTED_URL_LOGGING=false

# aria2 JSON-RPC
ARIA2_RPC_URL=http://rd-aria2:6800/jsonrpc
ARIA2_RPC_SECRET=
ARIA2_DOWNLOAD_DIR=/downloads
ARIA2_MAX_CONNECTION_PER_SERVER=8
ARIA2_SPLIT=8

# Host paths for docker compose bind mounts (compose.example.yml)
# DOWNLOAD_DIR: set to your own host download directory, e.g. /mnt/media/downloads
DOWNLOAD_DIR=./downloads
CONFIG_DIR=./config
ARIA2_CONFIG_DIR=./aria2-config
